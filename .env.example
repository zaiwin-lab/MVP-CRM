# Copy this file to `.env` and fill in your Supabase project details.
# WITHOUT these values the app runs in local "demo mode" (data saved in your
# browser only). WITH them, the whole office shares one live database.
#
# Find these in your Supabase project: Settings -> API
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
